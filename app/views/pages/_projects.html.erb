<section id="projects" class="py-24 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="text-sm font-medium text-gray-500 uppercase tracking-widest mb-2">What I've been working on</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900">My Latest Projects</h2>
      </div>
      <%= link_to "All articles &rarr;".html_safe, articles_path, class: "hidden sm:inline text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @case_studies.each do |article| %>
        <%= render "articles/card", article: article, show_meta: false %>
      <% end %>
    </div>
  </div>
</section>
