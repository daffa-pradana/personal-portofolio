<% content_for :title, "Knowledge Entries — Admin" %>

<div class="flex items-center justify-between">
  <h1 class="font-bold text-3xl text-gray-900">Knowledge Entries</h1>
  <%= link_to "New Entry", new_admin_knowledge_entry_path, class: "rounded-md px-3.5 py-2.5 bg-gray-900 hover:bg-gray-700 text-white text-sm font-medium" %>
</div>

<div class="mt-8 border border-gray-200 rounded-xl bg-white overflow-x-auto">
  <table class="w-full text-sm text-left">
    <thead class="border-b border-gray-200 text-gray-500">
      <tr>
        <th class="px-4 py-3 font-medium">Category</th>
        <th class="px-4 py-3 font-medium">Title</th>
        <th class="px-4 py-3 font-medium">Position</th>
        <th class="px-4 py-3 font-medium"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @knowledge_entries.each do |entry| %>
        <tr>
          <td class="px-4 py-3 text-gray-600"><%= entry.category %></td>
          <td class="px-4 py-3 font-medium text-gray-900"><%= entry.title %></td>
          <td class="px-4 py-3 text-gray-600"><%= entry.position %></td>
          <td class="px-4 py-3 text-right whitespace-nowrap">
            <%= link_to "Edit", edit_admin_knowledge_entry_path(entry), class: "text-gray-900 underline hover:no-underline" %>
            <%= button_to "Delete", admin_knowledge_entry_path(entry), method: :delete,
                  form: { data: { turbo_confirm: "Delete \"#{entry.title}\"? This can't be undone." } },
                  class: "ml-4 text-red-600 underline hover:no-underline bg-transparent cursor-pointer inline" %>
          </td>
        </tr>
      <% end %>

      <% if @knowledge_entries.empty? %>
        <tr>
          <td colspan="4" class="px-4 py-6 text-center text-gray-500">No knowledge entries yet.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
