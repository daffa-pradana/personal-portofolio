# Template for local secrets. Copy it, then fill in real values:
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed — this file is the only
# .env* that is tracked, and it holds placeholders only.
#
# Loaded automatically in development and test by dotenv-rails, so these are
# available to bin/dev, bin/rails console, bin/rails runner and bin/rails test
# without prefixing anything onto the command.

# --- AI chat (Batch 3) -------------------------------------------------------

# Required for the AI chat to answer anything. Without it, ChatService raises
# Unavailable and the UI shows "The AI assistant is temporarily unavailable."
# Get a free key at https://console.groq.com/keys
# See docs/groq-api-key-setup.md for the full walkthrough.
GROQ_API_KEY=

# Optional — only set these to point the chat at a different provider or model.
# ChatService speaks the generic OpenAI-compatible /chat/completions contract,
# so any compatible provider works (OpenRouter, Together, Cerebras, Gemini's
# compat endpoint). Defaults live in app/services/chat_service.rb.
#
# Providers retire model names periodically — if the chat starts returning
# "temporarily unavailable" with an HTTP 404 in the log, the model is likely
# gone. List what your key can actually use with:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" \
#        https://api.groq.com/openai/v1/models
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b

# --- Admin user seeding ------------------------------------------------------

# Used only by `bin/rails db:seed` to create/reset the admin CMS login.
# Seeding is a no-op when these are absent. Re-running with a different
# password resets it — that is also how to recover a forgotten one.
# Also required for deploying (see below) — .kamal/secrets reads these same
# values out of this file and injects them into the production container so
# the same db:seed call works there too.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# --- Deploy (Kamal / Biznet Gio) ----------------------------------------------

# Only needed on the machine that runs `bin/kamal ...` — never read at
# runtime by the Rails app itself. .kamal/secrets sources this same file.

# A GitHub Personal Access Token with the write:packages scope (classic
# token, or fine-grained with "Packages" write access). Used to push the
# built image to ghcr.io/daffa-pradana/personal_portofolio.
KAMAL_REGISTRY_PASSWORD=

# Any strong random string, chosen once when the Postgres accessory first
# boots. Changing it after the volume exists won't update the running
# database's actual password — treat it as fixed once set.
POSTGRES_PASSWORD=
